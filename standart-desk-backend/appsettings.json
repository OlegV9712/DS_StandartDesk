{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=standart-desk.db"
  },
  "Database": {
    "Provider": "sqlite"
  },
  "AllowedOrigins": [
    "http://localhost:5173",
    "https://localhost:5173",
    "http://localhost:3000",
    "https://localhost:3000"
  ],
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Jwt": {
    "Key": "your-super-secret-jwt-key-must-be-at-least-64-characters-long-change-in-production-now",
    "Issuer": "StandartDesk",
    "Audience": "StandartDeskUsers",
    "ExpireDays": 7
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "endpoint": "*",
        "period": "1m",
        "limit": 100
      },
      {
        "endpoint": "*:/api/auth/login",
        "period": "15m",
        "limit": 5
      },
      {
        "endpoint": "*:/api/auth/register",
        "period": "1h",
        "limit": 10
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpWhitelist": [
      "127.0.0.1",
      "::1"
    ]
  }
}
